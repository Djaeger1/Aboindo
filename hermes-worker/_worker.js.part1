let _regexTerjemahan = null;
function terjemahkanHTMLStatis(html) {
  if (!_regexTerjemahan) {
    const keys = Object.keys(KAMUS_SERVER).sort((a,b) => b.length - a.length);
    const escaped = keys.map(k => k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    _regexTerjemahan = new RegExp(escaped.join('|'), 'g');
  }
  // Split by script tags first
  const parts = html.split(/(<script[^>]*>[\s\S]*?<\/script>)/gi);
  for (let i = 0; i < parts.length; i++) {
    if (i % 2 === 1) continue; // script part, skip
    // Now split by HTML tags, only translate text between tags
    const segments = parts[i].split(/(<[^>]+>)/g);
    for (let j = 0; j < segments.length; j++) {
      if (j % 2 === 1) continue; // HTML tag, skip
      const text = segments[j];
      if (/[\u4e00-\u9fff]/.test(text)) {
        segments[j] = text.replace(_regexTerjemahan, m => KAMUS_SERVER[m] || m);
      }
    }
    parts[i] = segments.join('');
  }
  return parts.join('');
}

async function injeksiTerjemahan(url) {
  const r = await fetch(url);
  let html = await r.text();
  // PASS-THROUGH: translation disabled - cards fail to render with translation active
  const headers = new Headers(r.headers);
  headers.set('Content-Type', 'text/html;charset=utf-8');
  return new Response(html, { status: r.status, headers });
}




