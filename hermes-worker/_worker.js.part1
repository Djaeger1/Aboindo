var keys = Object.keys(KAMUS).sort(function(a,b){return b.length - a.length;});

function terjemahkanTeks(text) {
  if (!text || !/[\\u4e00-\\u9fff]/.test(text)) return text;
  var result = text;
  for (var i = 0; i < keys.length; i++) {
    var k = keys[i];
    if (result.indexOf(k) !== -1) {
      result = result.split(k).join(KAMUS[k]);
    }
  }
  return result;
}

function terjemahkanNode(node) {
  if (node.nodeType === 3) {
    var baru = terjemahkanTeks(node.nodeValue);
    if (baru !== node.nodeValue) node.nodeValue = baru;
  } else if (node.nodeType === 1) {
    ['placeholder', 'title', 'alt'].forEach(function(attr) {
      if (node.hasAttribute && node.hasAttribute(attr)) {
        var v = node.getAttribute(attr);
        var baru = terjemahkanTeks(v);
        if (baru !== v) node.setAttribute(attr, baru);
      }
    });
    var anak = node.childNodes;
    for (var i = 0; i < anak.length; i++) {
      terjemahkanNode(anak[i]);
    }
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    terjemahkanNode(document.body);
    document.title = terjemahkanTeks(document.title);
    document.documentElement.lang = 'id';
  });
} else {
  terjemahkanNode(document.body);
  document.title = terjemahkanTeks(document.title);
  document.documentElement.lang = 'id';
}

var observer = new MutationObserver(function(mutations) {
  mutations.forEach(function(m) {
    m.addedNodes.forEach(function(n) {
      terjemahkanNode(n);
    });
    if (m.type === 'characterData') {
      var baru = terjemahkanTeks(m.target.nodeValue);
      if (baru !== m.target.nodeValue) m.target.nodeValue = baru;
    }
  });
});

observer.observe(document.body, {
  childList: true,
  subtree: true,
  characterData: true
});
})();
</script>`;

