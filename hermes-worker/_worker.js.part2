    else _cy += 'dns:\n  enable: true\n  enhanced-mode: fake-ip\n  fake-ip-range: 198.18.0.1/16\n  fake-ip-filter:\n    - \'*.lan\'\n    - \'*.local\'\n    - \'localhost\'\n    - \'*.msftconnecttest.com\'\n    - \'*.msftncsi.com\'\n  nameserver:\n    - https://8.8.8.8/dns-query\n    - https://1.1.1.1/dns-query\n';
    _cy += 'proxies:\n';
    _cips.forEach((ip, i) => {
        const _nm = _cnames[i];
        if (_cp === 'trojan') _cy += '  - {name: ' + _nm + ', server: ' + ip + ', port: 443, type: trojan, password: ' + _cu + ', sni: ' + host + ', client-fingerprint: chrome, network: ws, ws-opts: {path: /, headers: {Host: ' + host + '}}}\n';
        else _cy += '  - {name: ' + _nm + ', server: ' + ip + ', port: 443, type: vless, uuid: ' + _cu + ', tls: true, servername: ' + host + ', client-fingerprint: chrome, network: ws, ws-opts: {path: /, headers: {Host: ' + host + '}}}\n';
    });
