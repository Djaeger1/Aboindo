		if (访问路径 === 'countries') { const _cj = await env.KV.get('COUNTRIES.json') || '[]'; return new Response(_cj, { headers: { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' } }); }
		// === HERMES: clashyaml + shorten (tambah 2026-09-30) ===
if (访问路径 === 'clashyaml') {
