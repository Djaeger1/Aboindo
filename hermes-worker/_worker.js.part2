}
if (访问路径 === 'shorten') {
    const _su = url.searchParams.get('url') || '';
    if (!_su.startsWith('https://' + host + '/')) return new Response('only own-host urls', { status: 400 });
    const _abc = 'abcdefghijklmnopqrstuvwxyz0123456789';
    let _sid = '';
